<section class="page-heading"><div><%= link_to "← Tüm talepler", tickets_path, class: "back" %><h1>Yeni destek talebi</h1><p>Önceliği seçin; SLA son tarihi otomatik hesaplansın.</p></div></section>
<section class="panel new-form"><% if @ticket.errors.any? %><div class="flash alert"><%= @ticket.errors.full_messages.join(', ') %></div><% end %><%= form_with model: @ticket do |f| %><%= f.label :title, "Talep başlığı" %><%= f.text_field :title, required: true %><%= f.label :description, "Açıklama" %><%= f.text_area :description, rows: 4, required: true %><%= f.label :customer_name, "Müşteri adı" %><%= f.text_field :customer_name, required: true %><%= f.label :customer_email, "E-posta" %><%= f.email_field :customer_email, required: true %><%= f.label :priority, "Öncelik" %><%= f.select :priority, Ticket::PRIORITIES.map { |p| [priority_label(p), p] } %><%= f.submit "Talebi oluştur", class: "button primary" %><% end %></section>
