<section class="page-heading"><div><%= link_to "← Tüm talepler", tickets_path, class: "back" %><h1><%= @ticket.title %></h1><p>#PD-<%= @ticket.id.to_s.rjust(4, '0') %> · <%= @ticket.customer_name %> · <%= @ticket.customer_email %></p></div><span class="badge <%= @ticket.status %>"><%= status_label(@ticket.status) %></span></section>
<div class="detail-grid"><div>
<section class="panel"><div class="panel-heading"><h2>Talep akışı</h2><span class="priority <%= @ticket.priority %>">● <%= priority_label(@ticket.priority) %></span></div><div class="flow"><% Ticket::STATUSES.each_with_index do |status, i| %><span class="<%= @ticket.status == status ? 'current' : '' %>"><b><%= i + 1 %></b><%= status_label(status) %></span><% end %></div><div class="description"><%= simple_format @ticket.description %></div><div class="actions"><% Ticket::TRANSITIONS.fetch(@ticket.status).each do |status| %><%= button_to "#{status_label(status)} olarak işaretle", transition_ticket_path(@ticket), method: :patch, params: { status: status }, class: "button" %><% end %></div></section>
<section class="panel conversation"><div class="panel-heading"><h2>Konuşma</h2><span class="muted"><%= @comments.size %> yanıt</span></div><div class="comments"><% @comments.each do |comment| %><article class="comment <%= comment.author_role %>"><div class="comment-meta"><strong><%= comment.author_name %></strong><span><%= comment.author_role == 'agent' ? 'Temsilci' : 'Müşteri' %> · <%= comment.created_at.strftime('%d.%m %H:%M') %></span></div><%= simple_format comment.body %><% if comment.prevented_reopen? %><span class="guard-label">✦ Teşekkür filtresi çözümü korudu</span><% end %></article><% end %><% if @comments.empty? %><p class="muted">Henüz yanıt yok. İlk yanıtı aşağıdan gönderin.</p><% end %></div>
<%= form_with url: reply_ticket_path(@ticket), class: "reply-form" do |f| %><%= f.label :author_role, "Yanıt türü" %><%= f.select :author_role, [["Temsilci Yanıtı", "agent"], ["Müşteri Yanıtı Simülasyonu", "customer"]] %><%= f.label :body, "Mesaj" %><%= f.text_area :body, required: true, rows: 3, maxlength: 10000, placeholder: "Yanıtınızı yazın…" %><%= f.submit "Yanıtı gönder →", class: "button primary" %><% end %></section>
</div><aside class="detail-side"><section class="panel side-card"><div class="eyebrow">HİZMET SEVİYESİ</div><h2>SLA takibi</h2><%= render "sla", ticket: @ticket %><dl><dt>Son tarih</dt><dd><%= @ticket.sla_due_at.strftime('%d.%m.%Y %H:%M') %></dd><dt>İlk yanıt</dt><dd><%= @ticket.first_responded_at&.strftime('%d.%m %H:%M') || 'Bekleniyor' %></dd><dt>Çözüm zamanı</dt><dd><%= @ticket.solved_at&.strftime('%d.%m %H:%M') || 'Henüz çözülmedi' %></dd></dl><%= form_with url: assign_ticket_path(@ticket), method: :patch do |f| %><%= f.label :assigned_agent, "Atanan temsilci" %><%= f.select :assigned_agent, Ticket::AGENTS, selected: @ticket.assigned_agent, prompt: "Temsilci seçin" %><%= f.submit "Temsilci ata", class: "button full" %><% end %></section>
<section class="panel side-card guard-card"><div class="eyebrow">SMART REOPEN GUARD</div><h2>Çözümünüz koruma altında.</h2><p>Bu talepte <strong><%= @ticket.reopen_prevented_count %></strong> gereksiz yeniden açılma önlendi.</p><small>Hızlı test için talebi önce çözülen durumuna getirin.</small><%= button_to "Müşteri 'Teşekkürler!' Yazsın (100 Puanlık Pas Testi)", reply_ticket_path(@ticket), params: { author_role: "customer", body: "Teşekkürler!" }, class: "button full" %><%= button_to "Müşteri 'Hâlâ Çalışmıyor!' Yazsın", reply_ticket_path(@ticket), params: { author_role: "customer", body: "Hâlâ Çalışmıyor!" }, class: "button full" %></section>
<% if Rails.env.development? %><section class="panel side-card"><div class="eyebrow">SUNUM ARAÇLARI</div><%= button_to "Simülasyon: Zamanı +5 Saat İleri Sar (SLA Testi)", simulate_ticket_path(@ticket), class: "button full warning" %><small>Başlangıç ve SLA son tarihi 5 saat geriye alınır.</small></section><% end %></aside></div>
